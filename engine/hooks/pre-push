#!/bin/bash
# git pre-push 훅: 로컬에서 배포/푸시 전 보안 게이트.
# 설치: cp engine/hooks/pre-push .git/hooks/ && chmod +x .git/hooks/pre-push
set -e
BASE="${GUARDRAIL_BASE:-http://127.0.0.1:3000}"
echo "가드레일 보안 게이트 실행 중… ($BASE)"
if ! curl -sf -o /dev/null "$BASE" 2>/dev/null; then
  echo "⚠ 앱($BASE)이 안 떠 있어 게이트를 건너뜁니다. GUARDRAIL_BASE로 지정하세요."
  exit 0
fi
node "$(git rev-parse --show-toplevel)/engine/gate.js" "$BASE" --src "$(git rev-parse --show-toplevel)" || {
  echo "✗ 확정 취약점이 남아 푸시를 막습니다. 고치거나 GATE_ALLOW로 승인하세요."
  exit 1
}
